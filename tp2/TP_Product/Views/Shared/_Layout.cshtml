@using Microsoft.AspNetCore.Identity
@using TP_Product.Models.Help
@inject SignInManager<IdentityUser> SignInManager
@inject TP_Product.Models.Repositories.ICategorieRepository CategRepository
@{
    // Nombre total d'articles dans le panier (pour le badge)
    var nbArticles = ListeCart.CountInSession(Context.Session);
    var estAdminOuManager = SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Manager"));
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaBoutique</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Police moderne : Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP_Product.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-glass sticky-top mb-4">
            <div class="container-fluid">
                <!-- Bouton qui ouvre / ferme le menu des catégories -->
                <button class="btn btn-icon me-2" id="toggleMenu" type="button" title="Catégories">
                    <i class="bi bi-list"></i>
                </button>
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-heart-fill"></i> <span class="brand-text">MaBoutique</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index"><i class="bi bi-grid"></i> Produits</a>
                        </li>
                        @if (estAdminOuManager)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false"><i class="bi bi-gear"></i> Gestion</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Tableau de bord</a>
                                    <div class="dropdown-divider"></div>
                                    <h6 class="dropdown-header">Articles</h6>
                                    <a class="dropdown-item" asp-area="" asp-controller="Product" asp-action="Index">Tous les articles</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Product" asp-action="Create">Nouvel Article</a>
                                    <div class="dropdown-divider"></div>
                                    <h6 class="dropdown-header">Catégories</h6>
                                    <a class="dropdown-item" asp-area="" asp-controller="Category" asp-action="Index">Toutes les catégories</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Category" asp-action="Create">Nouvelle catégorie</a>
                                </div>
                            </li>
                        }
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false"><i class="bi bi-shield-lock"></i> Administration</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="CreateRole">Create Role</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="ListRoles">List Roles</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="" asp-controller="Commande" asp-action="Index"><i class="bi bi-receipt"></i> Toutes les commandes</a>
                                </div>
                            </li>
                        }
                    </ul>

                    <!-- Recherche -->
                    <form class="d-flex my-2 my-lg-0 me-lg-3" method="get" asp-area="" asp-controller="Product" asp-action="Index">
                        <div class="input-group search-pill">
                            <input class="form-control" type="search" placeholder="Rechercher un produit..." name="search">
                            <button class="btn btn-gradient" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <ul class="navbar-nav align-items-lg-center">
                        <!-- Panier avec badge -->
                        <li class="nav-item">
                            <a class="nav-link position-relative me-lg-3" asp-area="" asp-controller="Panier" asp-action="Index">
                                <i class="bi bi-cart3 fs-5"></i>
                                @if (nbArticles > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill cart-badge">@nbArticles</span>
                                }
                            </a>
                        </li>
                        <!-- Menu utilisateur -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i> @User.Identity.Name
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" asp-controller="Panier" asp-action="MesCommandes"><i class="bi bi-bag-check"></i> Mes commandes</a>
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-controller="account" asp-action="logout">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gradient btn-sm ms-lg-2 px-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid flex-grow-1">
        <div class="row">
            <!-- Menu latéral pour les catégories -->
            <div class="col-md-2" id="sidebar" style="display: none;">
                <ul class="list-group">
                    @await Html.PartialAsync("_CategoriesMenu", CategRepository.GetAll())
                </ul>
            </div>

            <!-- Contenu principal -->
            <div class="col-md-12" id="mainContent">
                <main role="main" class="pb-4">
                    <partial name="_Notifications" />
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <footer class="site-footer text-light pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold"><i class="bi bi-bag-heart-fill"></i> À propos</h5>
                    <p class="text-white-50 small">MaBoutique est une boutique en ligne réalisée avec ASP.NET Core MVC dans le cadre des TPs .NET.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Contact</h5>
                    <ul class="list-unstyled text-white-50 small">
                        <li><i class="bi bi-geo-alt"></i> Tunis, Tunisie</li>
                        <li><i class="bi bi-envelope"></i> contact@maboutique.tn</li>
                        <li><i class="bi bi-telephone"></i> +216 00 000 000</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Réseaux sociaux</h5>
                    <a href="#" class="social-link me-2"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link me-2"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link me-2"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
            <hr class="border-secondary" />
            <div class="text-center text-white-50 small">
                &copy; 2026 - MaBoutique - <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/CustomScript.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
