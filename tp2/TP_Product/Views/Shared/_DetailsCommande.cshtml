@model TP_Product.Models.Order
@* Détail d'une commande : utilisé par Confirmation, Mes commandes et l'administration *@
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card form-card h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle"></i> Informations</h5>
                <ul class="list-unstyled order-info mb-0">
                    <li><span>Numéro</span><strong>#@Model.Id</strong></li>
                    <li><span>Date</span><strong>@Model.OrderDate.ToString("dd/MM/yyyy à HH:mm")</strong></li>
                    <li><span>Client</span><strong>@Model.CustomerName</strong></li>
                    <li><span>Email</span><strong>@Model.Email</strong></li>
                    <li><span>Adresse</span><strong>@Model.Address</strong></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card form-card h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-box-seam"></i> Articles commandés</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th>Quantité</th>
                                <th>Prix unitaire</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Price.ToDT()</td>
                                    <td class="text-end">@((item.Price * item.Quantity).ToDT())</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Montant total</th>
                                <th class="text-end product-price">@Model.TotalAmount.ToDT()</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
