@* Messages de confirmation (TempData) affichés en haut à droite, puis fermés automatiquement *@
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="notifications">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow notif" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow notif" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
    </div>
    <script>
        // Fermer les messages automatiquement après 5 secondes
        window.addEventListener("load", function () {
            setTimeout(function () {
                document.querySelectorAll(".notif").forEach(function (el) {
                    bootstrap.Alert.getOrCreateInstance(el).close();
                });
            }, 5000);
        });
    </script>
}
