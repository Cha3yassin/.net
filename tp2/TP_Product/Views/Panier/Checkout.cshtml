@model TP_Product.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "CheckOut";
}
<h2 class="fw-bold mb-4"><i class="bi bi-credit-card"></i> Passer la commande</h2>
<div class="row g-4">
    <!-- Formulaire de commande -->
    <div class="col-lg-5">
        <div class="card form-card shadow">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Informations de livraison</h5>
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="Address" class="form-label">Adresse de livraison :</label>
                        <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required />
                    </div>
                    <div class="form-group">
                        <label for="PaymentMethod" class="form-label">Méthode de paiement :</label>
                        <select class="form-select" id="PaymentMethod" name="PaymentMethod">
                            <option value="CreditCard">Carte de crédit</option>
                            <option value="Paypal">PayPal</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Montant total :</label>
                        <p class="product-price mb-0">@Model.TotalAmount.ToDT()</p>
                        <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />
                    </div>
                    @* Champs cachés pour les articles du panier *@
                    @for (int i = 0; i < Model.CartItems.Count; i++)
                    {
                        <input type="hidden" name="CartItems[@i].ProductName" value="@Model.CartItems[i].ProductName" />
                        <input type="hidden" name="CartItems[@i].Quantity" value="@Model.CartItems[i].Quantity" />
                        <input type="hidden" name="CartItems[@i].Price" value="@Model.CartItems[i].Price" />
                    }
                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-check2-circle"></i> Passer la commande</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Récapitulatif du panier -->
    <div class="col-lg-7">
        <div class="card form-card shadow">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-cart3"></i> Votre panier</h5>
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nom du produit</th>
                            <th>Quantité</th>
                            <th>Prix Unitaire</th>
                            <th>Total Ligne</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@item.Price.ToDT()</td>
                                <td class="fw-semibold">@((item.Price * item.Quantity).ToDT())</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
