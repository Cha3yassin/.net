@model TP_Product.Models.Order
@{
    ViewData["Title"] = "Confirmation";
}
<div class="text-center mb-4">
    <span class="form-icon success-icon"><i class="bi bi-check-lg"></i></span>
    <h1 class="fw-bold mt-3">Votre commande a été validée avec succès !</h1>
    <p class="text-muted">Merci pour votre achat, @Model.CustomerName ! Votre commande a bien été enregistrée.</p>
</div>

<partial name="_DetailsCommande" model="Model" />

<div class="text-center mt-4 d-flex gap-2 justify-content-center flex-wrap">
    <a asp-controller="Panier" asp-action="MesCommandes" class="btn btn-outline-primary"><i class="bi bi-bag-check"></i> Mes commandes</a>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary"><i class="bi bi-shop"></i> Continuer mes achats</a>
</div>
