@model IEnumerable<TP_Product.Models.Product>
@{
    ViewData["Title"] = "Liste des produits";
    // Notes moyennes des produits (étoiles)
    var notes = ViewBag.Notes as Dictionary<int, NoteProduit> ?? new Dictionary<int, NoteProduit>();
    string sortOrder = ViewBag.SortOrder;
    // Prix écrits avec un point (12.5) pour l'URL et les champs number
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string minPrice = ViewBag.MinPrice == null ? null : ((float)ViewBag.MinPrice).ToString(inv);
    string maxPrice = ViewBag.MaxPrice == null ? null : ((float)ViewBag.MaxPrice).ToString(inv);

    // Critères actuels, réutilisés par les liens de pagination
    var criteres = new Dictionary<string, string>();
    if (ViewBag.CategoryId != null) criteres["categoryId"] = ViewBag.CategoryId.ToString();
    if (!string.IsNullOrEmpty((string)ViewBag.Search)) criteres["search"] = ViewBag.Search;
    if (minPrice != null) criteres["minPrice"] = minPrice;
    if (maxPrice != null) criteres["maxPrice"] = maxPrice;
    if (!string.IsNullOrEmpty(sortOrder)) criteres["sortOrder"] = sortOrder;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-grid"></i> Nos produits</h2>
    <span class="text-muted">@ViewBag.TotalProducts produit(s)</span>
</div>

<!-- Recherche, filtres et tri -->
<form asp-action="Index" method="get" class="card form-card filter-bar mb-4">
    <div class="card-body p-3">
        @if (ViewBag.CategoryId != null)
        {
            <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
        }
        <div class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small text-muted mb-1">Rechercher</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Nom du produit..." />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label small text-muted mb-1">Prix min (DT)</label>
                <input type="number" step="0.001" min="0" name="minPrice" value="@minPrice" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label small text-muted mb-1">Prix max (DT)</label>
                <input type="number" step="0.001" min="0" name="maxPrice" value="@maxPrice" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small text-muted mb-1">Trier par</label>
                <select name="sortOrder" class="form-select">
                    <option value="">Plus récents</option>
                    <option value="price_asc" selected="@(sortOrder == "price_asc")">Prix croissant</option>
                    <option value="price_desc" selected="@(sortOrder == "price_desc")">Prix décroissant</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Filtrer</button>
                <a asp-action="Index" class="btn btn-light" title="Réinitialiser"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> Aucun produit trouvé.
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
    @foreach (var product in Model)
    {
        var photoPath = "~/images/" + (product.Image ?? "noimage.jpg");
        <div class="col">
            <div class="card product-card h-100 shadow-sm">
                <div class="product-img-wrap">
                    <img class="card-img-top imageThumbnail" src="@photoPath" asp-append-version="true" alt="@product.Name" />
                    <span class="category-badge">@product.Category?.CategoryName</span>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-semibold">@product.Name</h5>
                    <partial name="_Etoiles" model="@(notes.GetValueOrDefault(product.ProductId) ?? new NoteProduit())" />
                    <div class="product-price mb-2">@product.Price.ToDT()</div>
                    <div class="mb-3">
                        @if (product.QteStock > 0)
                        {
                            <span class="stock-badge stock-in"><i class="bi bi-check-circle"></i> En stock (@product.QteStock)</span>
                        }
                        else
                        {
                            <span class="stock-badge stock-out"><i class="bi bi-x-circle"></i> Rupture de stock</span>
                        }
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                           class="btn btn-outline-primary flex-fill">
                            <i class="bi bi-eye"></i> Voir
                        </a>
                        @if (product.QteStock > 0)
                        {
                            <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@product.ProductId"
                               class="btn btn-primary flex-fill">
                                <i class="bi bi-cart-plus"></i> Ajouter
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary flex-fill" disabled>
                                <i class="bi bi-cart-x"></i> Indisponible
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination Bootstrap -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="criteres" asp-route-page="@(currentPage - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="criteres" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="criteres" asp-route-page="@(currentPage + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
