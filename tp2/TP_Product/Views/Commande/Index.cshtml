@model IEnumerable<TP_Product.Models.Order>
@{
    ViewData["Title"] = "Toutes les commandes";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0"><i class="bi bi-receipt"></i> Toutes les commandes</h2>
    <div class="d-flex gap-3">
        <span class="stat-pill"><i class="bi bi-bag"></i> @Model.Count() commande(s)</span>
        <span class="stat-pill"><i class="bi bi-cash-stack"></i> @Model.Sum(o => o.TotalAmount).ToDT()</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">Aucune commande pour le moment.</div>
}
else
{
    <div class="card form-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">N°</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Email</th>
                            <th>Articles</th>
                            <th>Montant</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">#@o.Id</td>
                                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.CustomerName</td>
                                <td>@o.Email</td>
                                <td>@o.Items.Sum(i => i.Quantity)</td>
                                <td class="fw-semibold text-primary">@o.TotalAmount.ToDT()</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Détails
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
