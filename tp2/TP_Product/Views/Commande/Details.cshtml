@model TP_Product.Models.Order
@{
    ViewData["Title"] = "Commande #" + Model.Id;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-receipt"></i> Commande #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Toutes les commandes</a>
</div>
<partial name="_DetailsCommande" model="Model" />
