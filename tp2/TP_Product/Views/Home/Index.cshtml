@model TP_Product.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Accueil";
    // Notes moyennes des produits (étoiles)
    var notes = ViewBag.Notes as Dictionary<int, NoteProduit> ?? new Dictionary<int, NoteProduit>();
}

<!-- ===== 1. Bannière principale (Hero) ===== -->
<section class="hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="hero-tag"><i class="bi bi-stars"></i> Nouveautés 2026</span>
            <h1 class="hero-title mt-3">Découvrez notre <span>nouvelle collection</span></h1>
            <p class="hero-text">Les meilleurs produits au meilleur prix, livrés chez vous rapidement.
                Parcourez nos catégories et trouvez ce qu'il vous faut.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg px-4 hero-btn">
                    <i class="bi bi-bag"></i> Découvrir les produits
                </a>
                <a href="#categories" class="btn btn-outline-light btn-lg px-4">Voir les catégories</a>
            </div>
            <div class="d-flex flex-wrap gap-4 mt-4 hero-features">
                <span><i class="bi bi-truck"></i> Livraison rapide</span>
                <span><i class="bi bi-shield-check"></i> Paiement sécurisé</span>
                <span><i class="bi bi-arrow-repeat"></i> Retour gratuit</span>
            </div>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
            <i class="bi bi-bag-heart hero-icon"></i>
        </div>
    </div>
</section>

<!-- ===== 2. Section des catégories ===== -->
<section id="categories" class="mb-5">
    <div class="section-title">
        <h2>Nos catégories</h2>
        <p>Choisissez une catégorie pour voir ses produits</p>
    </div>
    @if (!Model.Categories.Any())
    {
        <div class="alert alert-info text-center">Aucune catégorie disponible.</div>
    }
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var c in Model.Categories)
        {
            <div class="col">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.CategoryId" class="category-card card h-100 text-decoration-none">
                    <div class="category-img">
                        @if (c.Image != null)
                        {
                            <img src="~/images/@c.Image" alt="@c.CategoryName" />
                        }
                        else
                        {
                            <i class="bi bi-tags"></i>
                        }
                    </div>
                    <div class="card-body text-center">
                        <h5 class="mb-1">@c.CategoryName</h5>
                        <small class="text-muted">@c.NbProduits produit(s)</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- ===== 3. Section des derniers produits ===== -->
<section class="mb-5">
    <div class="section-title d-flex justify-content-between align-items-end flex-wrap gap-2">
        <div>
            <h2>Derniers produits</h2>
            <p>Les nouveautés ajoutées à la boutique</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">Voir tout <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (!Model.DerniersProduits.Any())
    {
        <div class="alert alert-info text-center">Aucun produit disponible.</div>
    }
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var product in Model.DerniersProduits)
        {
            var photoPath = "~/images/" + (product.Image ?? "noimage.jpg");
            <div class="col">
                <div class="card product-card h-100">
                    <div class="product-img-wrap">
                        <img class="card-img-top" src="@photoPath" asp-append-version="true" alt="@product.Name" />
                        <span class="category-badge">@product.Category?.CategoryName</span>
                        <span class="new-badge">Nouveau</span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-semibold">@product.Name</h5>
                        <partial name="_Etoiles" model="@(notes.GetValueOrDefault(product.ProductId) ?? new NoteProduit())" />
                        <div class="product-price mb-3">@product.Price.ToDT()</div>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                               class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@product.ProductId"
                               class="btn btn-primary flex-fill">
                                <i class="bi bi-cart-plus"></i> Ajouter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
